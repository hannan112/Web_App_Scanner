# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Security Scanner <noreply@securityscanner.com>

# JWT Settings
JWT_SIGNING_KEY=your-jwt-signing-key-here

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OWASP ZAP Configuration
ZAP_HOST=localhost
ZAP_PORT=8080
ZAP_API_KEY=changeme123

# Active Scanning Configuration (optional)
ENABLE_ACTIVE_SCANNING=true
MAX_CONCURRENT_ACTIVE_SCANS=3
ACTIVE_SCAN_TIMEOUT_MINUTES=60
ZAP_ACTIVE_SCAN_STRENGTH=MEDIUM
ZAP_SPIDER_MAX_DEPTH=3
ZAP_SPIDER_MAX_DURATION=300

# Django Settings
# Generate a value with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# Email Settings (sent via Resend - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS=your-email@example.com
EMAIL_FROM_NAME=Security Scanner

# JWT Settings (falls back to SECRET_KEY if unset)
JWT_SIGNING_KEY=your-jwt-signing-key-here

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OWASP ZAP Configuration
ZAP_HOST=localhost
ZAP_PORT=8080
ZAP_API_KEY=changeme123

# Active Scanning Configuration (optional)
ENABLE_ACTIVE_SCANNING=true
MAX_CONCURRENT_ACTIVE_SCANS=3
ACTIVE_SCAN_TIMEOUT_MINUTES=60
ZAP_ACTIVE_SCAN_STRENGTH=MEDIUM
ZAP_SPIDER_MAX_DEPTH=3
ZAP_SPIDER_MAX_DURATION=300

# Production environment for docker-compose.prod.yml
# Copy to deployment/.env.prod and fill in real values.
# deployment/.env.prod is gitignored - never commit it.

ALLOWED_HOSTS=your-api-domain.com,www.your-api-domain.com
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
ZAP_API_KEY=generate-with-openssl-rand-hex-24
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com
